# Copy to .env. Values here are local-development defaults.
DATABASE_URL=postgresql+psycopg://swarm:swarm@localhost:5432/swarm
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=swarm-neo4j
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
STORAGE_DIR=./var/storage

# Run graph builds inside the API process instead of a Celery worker (no Redis needed).
CELERY_EAGER=false

# All models are local. Run Ollama (https://ollama.com) and `ollama pull gemma4` for GraphRAG
# answers, agent personas, simulated posts, reports and chat; without it those fall back to
# templates and retrieval. Extraction: auto (spaCy) | ollama (LLM, slow on CPU) | spacy | heuristic.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
EXTRACTION_PROVIDER=auto

# fastembed (local ONNX model) or hash (deterministic, offline, for tests)
EMBEDDING_PROVIDER=fastembed

# List the seeded demo accounts on the sign-in page. Set to false on any shared instance.
DEMO_ACCOUNTS=true
